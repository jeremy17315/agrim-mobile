# ─── Base de données ───────────────────────────────────────────
DATABASE_URL="postgresql://agrim:CHANGEME@127.0.0.1:5432/agrim_dev?schema=public"

# ─── API ───────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# ─── JWT (générer: openssl rand -base64 48) ────────────────────
# Les deux secrets doivent être DIFFÉRENTS : avec une valeur commune, un
# access token vaudrait refresh token et la révocation ne protégerait plus rien.
# En production, l'API refuse de démarrer si un secret ressemble à un exemple
# (« change », « secret », « test »…) ou fait moins de 32 caractères.
JWT_ACCESS_SECRET=CHANGEME_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGEME_refresh
JWT_REFRESH_TTL=30d

# ─── Chiffrement au repos (générer: openssl rand -base64 48) ───
# Protège les données courtes que leur propriétaire doit pouvoir relire, à ce
# jour le code de livraison. Distincte des secrets JWT : une clé qui signe des
# jetons ne doit pas aussi déchiffrer des données.
# La perdre rend les codes en cours illisibles ; ils sont alors à renvoyer.
ENCRYPTION_KEY=CHANGEME_encryption

# ─── CORS ──────────────────────────────────────────────────────
# Origines navigateur autorisées en production, séparées par des virgules.
# L'application mobile n'envoie pas d'Origin : laisser vide tant qu'aucun
# back-office web n'existe. En développement, tout est autorisé.
CORS_ORIGINS=

# ─── Mobile (EXPO_PUBLIC_* est LISIBLE dans le bundle) ─────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Stockage de fichiers (preuves de livraison, visuels produits) ---
# Pilote local : dossier sur disque. Pour plusieurs instances, prévoir un
# pilote S3-compatible derrière la meme interface StorageProvider.
# Les preuves de livraison ne sont PAS servies en statique : une signature
# manuscrite est une donnée personnelle. Elles se consultent via
# GET /files/proofs/:id, authentifié et soumis à un contrôle d'accès.
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_URL=http://127.0.0.1:3000/files

# --- Notifications poussees ---
# false : rien n'est envoye au service Expo (developpement, tests, CI).
# true  : envoi reel. Cote mobile, le push distant exige un dev build.
PUSH_ENABLED=false

# --- Integration avec le SITE ------------------------------------
# Le site rend DEUX services a cette API, sous la meme adresse et le meme
# jeton :
#
#   catalogue  : le site en est la source de verite (gammes, formats, prix,
#                promotions). Cette API en tient une copie locale mais ne
#                l'invente plus — un prix se corrige sur le site.
#   messagerie : le site envoie les SMS et WhatsApp pour tout le monde.
#                Un seul credit, un seul journal, un seul jeu de cles
#                d'agregateur. Le PUSH reste propre a cette application.
#
# URL de BASE du site, sans chemin. Vide = integration desactivee : le
# catalogue n'est plus synchronise et aucun SMS ne part. Mode de depannage,
# pas mode de production.
#
# SITE_INTEGRATION_TOKEN doit valoir exactement RB_SYNC_TOKEN cote site.
SITE_INTEGRATION_URL=https://riz-boigni-production.up.railway.app
SITE_INTEGRATION_TOKEN=CHANGEME_sync
CATALOG_SYNC_INTERVAL_MINUTES=15

# Surcharge facultative : catalogue servi ailleurs que sous
# ${SITE_INTEGRATION_URL}/api/integration/catalogue (proxy, recette).
# CATALOG_SOURCE_URL=
