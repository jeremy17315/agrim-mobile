# ── Base ────────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env` et adapter les secrets. Le `.env` est ignoré par
# git ; `.env.example` sert de modèle de déploiement et ne contient que des
# sous-ensembles valides pour lancer l'API.

# ── Node / serveur ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# ── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://agrim:agrim_test_pw@127.0.0.1:55432/agrim_dev?schema=public"

# ── JWT / session ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=test_access_secret_local_audit_session_only_1234
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test_refresh_secret_local_audit_session_only_1234
JWT_REFRESH_TTL=30d

# ── Chiffrement / sécurité ───────────────────────────────────────────────────
ENCRYPTION_KEY=test_encryption_key_local_audit_session_only_123456
CORS_ORIGINS=

# ── API mobile (expo) ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Stockage / fichiers ──────────────────────────────────────────────────────
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_URL=http://127.0.0.1:3000/files

# ── Intégration SITE (audit de cohérence, août 2026) ────────────────────────
# `SITE_INTEGRATION_URL` est l'URL de base du site, sans chemin. Vide =
# intégration désactivée : le catalogue local n'est plus synchronisé et aucun
# SMS ne part, mais l'API démarre et sert normalement.
SITE_INTEGRATION_URL=
SITE_INTEGRATION_TOKEN=CHANGEME_sync
CATALOG_SYNC_INTERVAL_MINUTES=15
CATALOG_SOURCE_URL=
RECONCILIATION_INTERVAL_MINUTES=10

# ── Pilote Sieve scrape API ──────────────────────────────────────────────────
# `SIEVE_API_KEY` porte la clé déployée par le fournisseur (store, jamais
# imprimée, jamais journalisée, jamais livrée au mobile). Vide = pilotage
# désactivé : les endpoints `/sieve/*` répondent 503 et le code ne tente
# aucun appel sortant. Comportement inchangé par rapport à une intégration
# absente.
SIEVE_BASE_URL=https://scrape.usesieve.com
SIEVE_API_KEY=CHANGEME_sieve_local_dev_key_only
