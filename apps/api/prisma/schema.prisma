// AGRIM-Mobile — schéma PostgreSQL
// Toute modification passe par une migration Prisma (section 12).
// Montants : entiers XOF, sans décimales. Poids : grammes entiers.

// Générateur « prisma-client » (Prisma 7, Rust-free) : aucun moteur natif,
// le client parle PostgreSQL via l'adaptateur @prisma/adapter-pg déjà en
// place (src/prisma/prisma.client.ts). Le générateur hérité
// « prisma-client-js », lui, exige le téléchargement de moteurs natifs —
// impossible sur un réseau filtré, et inutile ici.
generator client {
  provider                = "prisma-client"
  output                  = "../generated/prisma"
  runtime                 = "nodejs"
  moduleFormat            = "cjs"
  generatedFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}

/* ─────────────────────────────── Enums ─────────────────────────────── */

enum Role {
  CLIENT
  LIVREUR
  PRODUCTEUR
  GESTIONNAIRE
  ADMIN
  DG
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Cycle de vie d'un paiement — DEUX régimes cohabitent.
///
/// Agrégateur (historique, commandes antérieures au 11 octobre 2026) :
/// `PENDING` puis `AWAITING_CONFIRMATION`, tranché par webhook ou
/// réconciliation.
///
/// **Paiement direct manuel (régime en vigueur)** : le client transfère vers
/// le numéro officiel d'AGRIM puis déclare sa transaction
/// (`DECLARED_BY_CUSTOMER`) ; un responsable vérifie la réception réelle des
/// fonds et confirme (`SUCCEEDED`) ou rejette (`REJECTED`).
///
/// Invariant : rien n'atteint `SUCCEEDED` sans action humaine journalisée.
enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
  /// Le client a déclaré un transfert. Ni vérifié, ni confirmé.
  DECLARED_BY_CUSTOMER
  /// Vérification humaine en cours — dont le cas « montant annoncé ≠ attendu ».
  UNDER_REVIEW
  /// Déclaration écartée par AGRIM (fonds non reçus, référence invalide…).
  REJECTED
}

enum PaymentMethod {
  /// Agrégateur mobile money — historique, plus proposé aux nouvelles commandes.
  MOBILE_MONEY
  CARD
  CASH_ON_DELIVERY
  /// Transfert direct vers le numéro officiel d'AGRIM, vérifié manuellement.
  DIRECT_MOBILE_MONEY
}

enum MobileMoneyProvider {
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  WAVE
}

/// Méthodes de preuve retenues. Le code de confirmation a été écarté :
/// il échoue précisément quand on en a besoin (téléphone déchargé, tiers
/// qui réceptionne).
/// Origine de la clôture d'une livraison.
enum DeliveryClosureMode {
  /// Code dicté par le client et vérifié par le backend. Cas nominal.
  CLIENT_OTP

  /// Clôture par un gestionnaire, pour une remise réelle qu'aucun code ne
  /// pouvait valider. Motif obligatoire, auteur enregistré.
  MANAGER_OVERRIDE
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  IN_TRANSIT
  ARRIVED
  OTP_VERIFIED
  DELIVERED
  FAILED
}

/// Cycle de vie d'une déclaration de production.
/// Le producteur déclare ; la coopérative vérifie puis réceptionne. Un
/// producteur ne fait donc jamais passer sa propre déclaration en RECEIVED.
enum ProductionStatus {
  DECLARED
  CONFIRMED
  RECEIVED
  REJECTED
}

/// Origine d'un mouvement de stock.
///
/// Le signe de `quantity` dit le sens (+ entrée, − sortie) ; ce type dit la
/// RAISON. Les deux sont nécessaires : un −2 de commande et un −2 de casse
/// n'appellent pas la même lecture d'inventaire.
enum StockMovementType {
  /// Réapprovisionnement : de la marchandise entre en entrepôt.
  ENTREE

  /// Retrait décidé par la gestion : casse, don, prélèvement.
  SORTIE

  /// Correction d'inventaire après comptage physique. Ni entrée ni sortie
  /// réelle : c'est le compteur qui avait tort.
  AJUSTEMENT

  /// Réservé par une commande client.
  COMMANDE

  /// Rendu par l'annulation d'une commande.
  ANNULATION

  /// Marchandise revenue en entrepôt après coup.
  RETOUR
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  DELIVERY_ASSIGNED
  DELIVERY_OTP
  DELIVERY_FAILED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  /// Déclaration de paiement du client → destination : l'ÉQUIPE AGRIM.
  PAYMENT_DECLARED
  /// Réception des fonds vérifiée par un responsable.
  PAYMENT_CONFIRMED
  /// Déclaration écartée après vérification.
  PAYMENT_REJECTED
  /// Montant déclaré différent de l'attendu : arbitrage humain.
  PAYMENT_AMOUNT_MISMATCH
  /// Campagne commerciale rédigée dans l'administration.
  PROMOTION
  LOW_STOCK
}

/// Statut d'une déclaration de paiement déposée par un client.
/// Distinct de `PaymentStatus` : une déclaration a sa propre vie (déposée,
/// vérifiée, acceptée, refusée) et peut être rejouée si elle est refusée.
enum PaymentDeclarationStatus {
  DECLARED
  VERIFYING
  ACCEPTED
  REJECTED
}

/// Type de réduction d'un code promo.
enum PromoDiscountType {
  PERCENT
  FIXED
}

/// Cycle de vie d'une campagne de notifications.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

/// Public d'une campagne. Peu de valeurs à dessein : un ciblage flou envoie
/// des promotions à des clients qui n'en veulent pas, et coûte des refus.
enum CampaignAudience {
  ALL_OPTED_IN
  AUTHENTICATED
  TEST
}

/* ──────────────────────────── Utilisateurs ─────────────────────────── */

model User {
  id           String  @id @default(uuid()) @db.Uuid
  firstName    String  @db.VarChar(80)
  lastName     String  @db.VarChar(80)
  // Le téléphone est l'identifiant naturel en Côte d'Ivoire.
  phone        String  @unique @db.VarChar(20)
  email        String? @unique @db.VarChar(160)
  passwordHash String
  role         Role    @default(CLIENT)
  isActive     Boolean @default(true)
  /// Profil technique créé pour une commande invitée. Il ne permet aucune
  /// connexion et n'est jamais compté comme un compte client.
  isGuest      Boolean @default(false)

  // Parrainage (section 33). `referralCode` est attribué à l'inscription de
  // TOUS les comptes (pas seulement CLIENT), pour rester simple. Le crédit
  // est un solde générique, alimenté aujourd'hui uniquement par le
  // parrainage. `referralRewardedAt` vit sur le FILLEUL : il garantit qu'un
  // même filleul ne déclenche jamais deux fois la récompense de son parrain.
  referralCode       String    @unique @db.VarChar(12)
  referredById       String?   @db.Uuid
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")
  referralRewardedAt DateTime?
  creditBalanceXof   Int       @default(0)

  addresses      Address[]
  cart           Cart?
  orders         Order[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  deliveries     Delivery[]     @relation("CourierDeliveries")
  closedDeliveries Delivery[]   @relation("ClosedDeliveries")
  producer       Producer?
  pushTokens     PushToken[]
  productReviews ProductReview[]
  stockMovements StockMovement[]

  // ── Paiement direct manuel, codes promo, push ──────────────────────────
  // Ces relations portent la TRACABILITÉ : qui a changé un numéro de
  // réception, qui a confirmé un paiement, qui a envoyé une campagne.
  paymentMethodUpdates PaymentMethodConfig[] @relation("PaymentMethodUpdates")
  paymentReviews       PaymentDeclaration[]  @relation("PaymentReviews")
  paymentReviewLogs    PaymentReviewLog[]    @relation("PaymentReviewActor")
  campaignsCreated     NotificationCampaign[] @relation("CampaignsCreated")
  promoCodesCreated    PromoCode[]            @relation("PromoCodesCreated")
  pushDevices          PushDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([role, isGuest])
  @@index([referredById])
}

/// Refresh tokens hachés + rotation. Jamais stockés en clair.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Appareil abonné aux notifications poussées.
///
/// **Pourquoi une seconde table, à côté de `PushToken`** : `PushToken` exige un
/// `userId`, donc un COMPTE. Or le parcours d'achat est volontairement sans
/// compte — un client qui commande en invité doit quand même recevoir la
/// confirmation de son paiement et l'arrivée de son livreur. `PushDevice`
/// s'accroche à une INSTALLATION (identifiant aléatoire conservé sur
/// l'appareil), et le compte n'est qu'un rattachement facultatif.
///
/// Le rattachement par téléphone permet de joindre un invité : le numéro saisi
/// au moment de la commande est associé à l'appareil, et une notification de
/// commande invitée part vers les appareils qui portent ce numéro.
model PushDevice {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant d'installation, généré sur l'appareil, stable entre deux
  /// ouvertures et effacé à la réinstallation.
  installationId String @unique @db.VarChar(64)
  /// Jeton remis par le service de notifications (Expo, FCM…).
  token          String @unique @db.VarChar(255)
  /// `android` | `ios`.
  platform       String @db.VarChar(10)

  /// Compte connecté, si l'appareil en a un. Jamais exigé.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Téléphone déclaré sur cet appareil (commandes invitées). Format normalisé.
  phone String? @db.VarChar(20)

  /// Consentement aux notifications PROMOTIONNELLES. Les messages de commande
  /// et de paiement ne dépendent pas de cette préférence : ils servent le
  /// service rendu, pas la prospection.
  promoOptIn Boolean @default(true)

  /// Jeton encore valide. Un jeton refusé par le fournisseur est désactivé,
  /// pas supprimé : la trace explique pourquoi l'appareil ne reçoit plus rien.
  isActive Boolean @default(true)

  appVersion String?   @db.VarChar(30)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([phone])
  @@index([isActive, promoOptIn])
  @@map("push_devices")
}

/// Campagne de notifications, rédigée et envoyée depuis l'administration.
///
/// Les compteurs portent la distinction qui compte : `sentCount` est ce que le
/// service a ACCEPTÉ, `failedCount` ce qu'il a refusé. Aucun ne dit « lu » —
/// prétendre le contraire serait un mensonge d'interface.
model NotificationCampaign {
  id String @id @default(uuid()) @db.Uuid

  title String @db.VarChar(120)
  body  String @db.VarChar(500)
  /// PROMOTION | NOUVEAU_PRODUIT | PROMO_CODE | INFORMATION
  category String @db.VarChar(30)

  imageUrl String? @db.VarChar(500)

  /// Destination au tap : `produit`, `offre`, `categorie`, `commande`, `information`.
  linkTarget String? @db.VarChar(30)
  linkValue  String? @db.VarChar(120)

  audience CampaignAudience @default(ALL_OPTED_IN)
  status   CampaignStatus   @default(DRAFT)

  scheduledAt DateTime?
  sentAt      DateTime?
  /// Début du dernier envoi : distingue « en cours » de « bloqué ».
  sendingAt   DateTime?

  targetCount  Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  invalidCount Int @default(0)

  /// Dernière erreur remontée par le service push, tronquée.
  lastError String? @db.VarChar(500)

  createdById String? @db.Uuid
  createdBy   User?   @relation("CampaignsCreated", fields: [createdById], references: [id])

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@map("notification_campaigns")
}

/// Adresse adaptée au contexte ivoirien : GPS + repères, pas une simple rue.
model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String  @db.VarChar(60)
  city         String  @db.VarChar(80)
  commune      String? @db.VarChar(80)
  district     String? @db.VarChar(120)
  landmark     String? @db.VarChar(255)
  instructions String? @db.VarChar(500)
  contactPhone String  @db.VarChar(20)
  latitude     Float?
  longitude    Float?
  isDefault    Boolean @default(false)

  orders     Order[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/* ───────────────────────────── Catalogue ───────────────────────────── */

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(60)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]

  /// Code de l'unique gamme commerciale côté SITE (`BELIER_DOR`).
  /// Il préserve l'identité de la catégorie lors des synchronisations.
  sourceCode String? @unique @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String  @id @default(uuid()) @db.Uuid
  slug             String  @unique @db.VarChar(80)
  name             String  @db.VarChar(120)
  shortDescription String? @db.VarChar(200)
  description      String? @db.VarChar(2000)
  brand            String  @default("Bélier d’Or") @db.VarChar(80)
  imageUrl         String?
  isFeatured       Boolean @default(false)
  isActive         Boolean @default(true)

  categoryId String           @db.Uuid
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  reviews    ProductReview[]

  /// Code historique du produit dans le champ réseau `gammes` du SITE.
  /// Il évite de dupliquer un produit quand son nom ou son slug évolue.
  sourceCode String? @unique @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

/// Variante = format commercial. Prix en XOF entier, poids en grammes.
model ProductVariant {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String  @unique @db.VarChar(60)
  label       String  @db.VarChar(40)
  weightGrams Int
  price       Int
  /// Prix barré affiché en promotion (grille agrimsarl.ci). `null` = pas de
  /// promotion en cours.
  originalPrice Int?
  stock       Int     @default(0)
  /// Seuil d'alerte de réapprovisionnement, propre à chaque variante : un
  /// format 22,5 kg ne se réapprovisionne pas au même rythme qu'un 900 g.
  lowStockThreshold Int @default(20)
  isAvailable Boolean @default(true)

  /// Référence de la variante côté SITE (RB-EBE-05, RB-DC-225…).
  /// Clé de synchronisation du catalogue : c'est elle qui identifie une
  /// variante d'une exécution à l'autre, jamais le sku ni le libellé, qui
  /// peuvent être corrigés dans le back office du site.
  sourceRef String? @unique @db.VarChar(40)
  /// Dernière synchronisation réussie de cette variante depuis le site.
  syncedAt  DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  StockMovement[]
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/// Journal des mouvements de stock — une ligne par variation, sans exception.
///
/// Pourquoi cette table existe
/// ───────────────────────────
/// Le stock était un simple compteur : on lisait 148 sans pouvoir dire si
/// c'était 150 moins deux ventes, ou 200 moins une erreur de saisie. Un écart
/// d'inventaire n'était donc ni explicable ni imputable, et une correction
/// silencieuse ne laissait aucune trace.
///
/// Ce journal est le SEUL endroit qui répond à « pourquoi ce chiffre ? ».
/// Il est écrit dans la même transaction que la variation qu'il décrit : un
/// mouvement sans écriture de stock, ou l'inverse, n'existe pas.
///
/// `stockBefore` et `stockAfter` sont conservés bien qu'ils soient
/// recalculables : les relire évite de rejouer tout l'historique pour
/// comprendre une ligne, et surtout ils figent ce que le système CROYAIT au
/// moment du geste. Un écart entre `stockAfter` d'une ligne et `stockBefore`
/// de la suivante est le signal qu'une écriture a échappé au journal.
model StockMovement {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type StockMovementType

  /// Variation SIGNÉE : +50 à la réception, −2 à la commande.
  /// Jamais zéro — un mouvement nul n'est pas un mouvement.
  quantity    Int
  stockBefore Int
  stockAfter  Int

  /// Motif libre. Obligatoire pour un ajustement d'inventaire (règle tenue
  /// par le service, pas par la base : le motif d'une commande est implicite).
  reason String? @db.VarChar(300)

  /// Référence de commande pour les mouvements qui en découlent. C'est la
  /// clé qui permet de remonter d'un écart de stock à la vente qui l'explique.
  reference String? @db.VarChar(40)

  /// Auteur du geste. `null` pour un mouvement produit par le système
  /// (réservation à la commande, restitution par expiration d'un paiement) :
  /// mentir sur l'auteur serait pire que l'absence d'auteur.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  /// Sert la requête la plus fréquente : l'historique d'une variante, du plus
  /// récent au plus ancien.
  @@index([variantId, createdAt(sort: Desc)])
  @@index([type, createdAt])
  @@index([reference])
}

/// Avis client sur un produit.
///
/// Un couple (client, produit) : on note le riz, pas la commande. Modifier
/// son avis écrase le précédent plutôt que d'en empiler plusieurs.
model ProductReview {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Entier 1–5. Jamais de demi-étoile : un tap = une étoile.
  rating  Int
  comment String @db.VarChar(800)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

/* ─────────────────────────────── Panier ────────────────────────────── */

model Cart {
  id     String     @id @default(uuid()) @db.Uuid
  userId String     @unique @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un seul item par variante et par panier.
  @@unique([cartId, variantId])
  @@index([cartId])
}

/* ────────────────────────────── Commandes ──────────────────────────── */

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  reference String      @unique @db.VarChar(20)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)

  /// Coordonnées figées pour une commande passée sans compte. Elles vivent sur
  /// la commande, jamais dans un « compte invité » réutilisable, afin que le
  /// personnel voie immédiatement qui joindre sans créer d'identifiants.
  guestName  String? @db.VarChar(160)
  guestPhone String? @db.VarChar(20)

  // Prix figés au moment de la commande (ne suivent pas le catalogue).
  subtotal    Int
  deliveryFee Int
  /// Total réellement réclamé au client : `subtotal − remise − credit`.
  /// La remise promo n'a pas de colonne (elle est implicite dans ce total) ;
  /// le crédit de parrainage, lui, en a une — sans quoi une annulation serait
  /// incapable de savoir combien rendre, ni à qui.
  total Int

  /// Crédit de parrainage CONSOMMÉ par cette commande, en XOF.
  credit Int @default(0)

  /// Compte dont le crédit a été débité. Une commande invitée passée par un
  /// client CONNECTÉ garde `userId` = profil technique de livraison ; c'est ce
  /// champ qui désigne le vrai compte, donc le destinataire d'un remboursement.
  creditUserId String? @db.Uuid

  /// Date à laquelle le crédit a été rendu au compte (annulation). Sert de
  /// verrou d'idempotence : un crédit ne se rend jamais deux fois.
  creditRefundedAt DateTime?

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id])
  note      String? @db.VarChar(500)

  /// Empêche les doublons quand le réseau coupe et que le mobile rejoue.
  idempotencyKey String @unique @db.Uuid

  items    OrderItem[]
  payment  Payment?
  delivery Delivery?
  events   OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([guestPhone])
}

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Dénormalisé volontairement : l'historique doit rester lisible même si
  // le produit est renommé ou supprimé du catalogue.
  productName  String @db.VarChar(120)
  variantLabel String @db.VarChar(40)
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  @@index([orderId])
}

/// Journal d'audit des transitions de statut.
model OrderEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actorId   String?     @db.Uuid
  comment   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/* ────────────────────────────── Paiement ───────────────────────────── */

/// Le statut fait foi côté serveur uniquement (webhook), jamais côté mobile.
model Payment {
  id       String               @id @default(uuid()) @db.Uuid
  orderId  String               @unique @db.Uuid
  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method   PaymentMethod
  provider MobileMoneyProvider?
  status   PaymentStatus        @default(PENDING)
  /// Montant ATTENDU, figé au moment de la commande. C'est lui qui fait foi
  /// pendant la vérification : le client ne peut pas le modifier.
  amount   Int

  /// Code du moyen de paiement direct affiché au client (`ORANGE_MONEY`…).
  /// Dénormalisé volontairement : si AGRIM retire un moyen de paiement, on
  /// doit encore pouvoir dire vers quel numéro ce client-là a payé.
  methodCode        String?   @db.VarChar(40)
  /// Recopie du numéro officiel affiché, au moment de la commande.
  receivingNumber   String?   @db.VarChar(30)
  providerReference String?   @db.VarChar(120)
  failureReason     String?   @db.VarChar(255)
  expiresAt         DateTime?
  paidAt            DateTime?
  /// Horodatage de la confirmation HUMAINE (jamais automatique).
  confirmedAt       DateTime?

  declarations PaymentDeclaration[]
  reviews      PaymentReviewLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Moyen de paiement direct, **configuré par AGRIM** — jamais codé en dur.
///
/// Le numéro de réception n'existe QUE ici : il n'est ni dans le bundle
/// mobile, ni dans un fichier de code. Le corriger prend effet immédiatement,
/// sans nouvelle publication sur le Play Store.
model PaymentMethodConfig {
  id String @id @default(uuid()) @db.Uuid @map("id")

  /// Code technique stable (`ORANGE_MONEY`, `MTN_MOMO`, `WAVE`, …).
  code            String  @unique @db.VarChar(40)
  /// Nom affiché, rédigé par AGRIM (« Orange Money », « Wave »…).
  operatorName    String  @db.VarChar(80)
  /// Numéro officiel de réception, tel que le client doit le composer.
  receivingNumber String  @db.VarChar(30)
  /// Nom du bénéficiaire, quand AGRIM le renseigne (compte marchand).
  beneficiaryName String? @db.VarChar(120)
  /// Instructions rédigées par AGRIM, affichées au client.
  instructions    String? @db.VarChar(600)
  /// Modèle ouvrable par l'opérateur, s'il en existe un (`tel:` / USSD).
  ussdTemplate    String? @db.VarChar(200)

  /// Un moyen créé sans indication explicite est INACTIF : le publier par
  /// défaut l'exposerait aux clients avant relecture.
  isActive  Boolean @default(false)
  sortOrder Int     @default(0)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("PaymentMethodUpdates", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_method_configs")
}

/// Déclaration de paiement déposée par un client.
///
/// **Une déclaration n'est pas une preuve.** Elle ouvre une vérification : la
/// capture d'écran jointe est un indice, pas un encaissement. Un même
/// justificatif ne peut pas servir deux commandes — contrainte d'unicité sur
/// la référence de transaction, insensible à la casse.
model PaymentDeclaration {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Référence fournie par l'opérateur au client (`TX123456789`).
  transactionReference String  @db.VarChar(60)
  /// Même référence, normalisée (majuscules, sans espaces).
  ///
  /// C'est ELLE qui porte l'unicité : les opérateurs affichent la même
  /// référence selon les cas (`tx12ab` / `TX12AB`), et deux écritures de la
  /// même transaction ne doivent pas pouvoir servir deux commandes.
  transactionReferenceNormalized String @unique @db.VarChar(60)
  /// Montant annoncé par le client, en XOF entier.
  declaredAmount       Int
  /// Date du transfert telle que le client la déclare (facultative).
  paidAt               DateTime?
  /// Justificatif déposé (facultatif). Contrôlé : type MIME et taille.
  proofKey             String? @db.VarChar(200)
  proofMimeType        String? @db.VarChar(100)
  proofSizeBytes       Int?

  status PaymentDeclarationStatus @default(DECLARED)

  submittedAt   DateTime  @default(now())
  reviewedById  String?   @db.Uuid
  reviewedBy    User?     @relation("PaymentReviews", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  /// Motif affiché au client en cas de refus, rédigé par le vérificateur.
  rejectionNote String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status, submittedAt])
  @@map("payment_declarations")
}

/// Journal des décisions prises sur un paiement.
///
/// Écrit à CHAQUE action sensible : dépôt, mise en vérification, confirmation,
/// refus. Il porte l'identité de l'auteur, la date et l'heure, et ce qui a
/// changé. C'est la réponse à « qui a validé cet argent, et quand ? » — une
/// colonne `updatedAt` sur `Payment` ne peut pas y répondre.
model PaymentReviewLog {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// DECLARED | VERIFYING | CONFIRMED | REJECTED | AMOUNT_MISMATCH | NOTE
  action      String  @db.VarChar(30)
  fromStatus  String? @db.VarChar(30)
  toStatus    String? @db.VarChar(30)
  note        String? @db.VarChar(500)
  /// Auteur : administrateur, gestionnaire — ou `null` pour le client lui-même.
  /// La relation est en `SetNull` : effacer un compte ne doit pas effacer la
  /// preuve qu'une décision a été prise.
  actorId     String? @db.Uuid
  actor       User?   @relation("PaymentReviewActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   String? @db.VarChar(20)
  /// `CLIENT` | `STAFF` | `SYSTEM` : qui a déclenché l'écriture.
  actorSource String  @default("SYSTEM") @db.VarChar(10)
  /// Adresse IP de l'auteur d'une décision administrative (traçabilité).
  actorIp     String? @db.VarChar(60)

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_review_logs")
}

/* ────────────────────────────── Livraison ──────────────────────────── */

model Delivery {
  id      String         @id @default(uuid()) @db.Uuid
  orderId String         @unique @db.Uuid
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  DeliveryStatus @default(UNASSIGNED)

  courierId String? @db.Uuid
  courier   User?   @relation("CourierDeliveries", fields: [courierId], references: [id])

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id])

  failureReason String? @db.VarChar(255)

  /// Traçabilité de la validation par OTP : où et quand la course a été
  /// close. La position est facultative — le GPS documente la remise, il ne
  /// la conditionne pas.
  otpVerifiedAt DateTime?
  otpLatitude   Float?
  otpLongitude  Float?

  /// Comment la course a été close.
  ///
  /// Mesurable délibérément : une clôture d'exception reste légitime, mais si
  /// elle devient fréquente, c'est le signe que le parcours par code ne
  /// fonctionne pas sur le terrain. Sans cette colonne, personne ne le verrait.
  closureMode   DeliveryClosureMode?
  closedById    String?              @db.Uuid
  closedBy      User?                @relation("ClosedDeliveries", fields: [closedById], references: [id])
  closureReason String?              @db.VarChar(500)

  assignedAt  DateTime?
  acceptedAt  DateTime?
  inTransitAt DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  otps      DeliveryOtp[]
  locations DeliveryLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId, status])
  @@index([status])
  @@index([closureMode])
}

/// Code de validation de livraison.
///
/// Le code n'est JAMAIS stocké en clair : seule son empreinte l'est, comme un
/// mot de passe. Une fuite de la base ne permet donc pas de valider une
/// livraison. Le livreur ne le reçoit par aucun canal — il le saisit sous la
/// dictée du client.
///
/// L'historique est conservé (une ligne par génération) plutôt qu'écrasé : en
/// cas de litige, il faut pouvoir montrer combien de codes ont été émis et
/// lequel a validé la remise.
model DeliveryOtp {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  /// SHA-256 du code, pour la vérification (comparaison d'empreintes).
  codeHash String @db.VarChar(64)

  /// Le code CHIFFRÉ (AES-256-GCM), pour que son propriétaire puisse le relire.
  ///
  /// Le hachage seul ne suffisait pas : le client doit pouvoir consulter son
  /// code afin de le dicter. Tant qu'il vivait en clair dans le corps de la
  /// notification, hacher cette colonne ne protégeait rien.
  codeCipher String

  expiresAt DateTime

  /// Tentatives de saisie infructueuses, plafonnées.
  attempts Int @default(0)

  /// Renseigné une seule fois : un code vérifié est définitivement consommé.
  verifiedAt DateTime?

  /// Invalidation d'un code encore actif lors d'une régénération : à tout
  /// moment, une livraison n'a qu'un seul code utilisable.
  invalidatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
}

/// Trace GPS d'une course.
///
/// Minimisation des donnees : aucune position n'est collectee hors livraison
/// active, et les traces sont purgees apres livraison (TRACKING_CONFIG).
/// `recordedAt` est l'horodatage de la MESURE, pas de la reception serveur :
/// les points emis hors ligne sont rejoues plus tard sans fausser le trajet.
model DeliveryLocation {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  /// Precision horizontale en metres.
  accuracy  Float?
  /// Cap en degres, 0 = nord.
  heading   Float?
  /// Vitesse instantanee en m/s.
  speed     Float?

  recordedAt DateTime
  createdAt  DateTime @default(now())

  /// Deduplication des rejeux hors ligne : un meme point ne peut entrer deux fois.
  @@unique([deliveryId, recordedAt])
  /// Sert la lecture « derniere position connue », requete la plus frequente.
  @@index([deliveryId, recordedAt(sort: Desc)])
}

/* ──────────────────────────── Notifications ────────────────────────── */

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String           @db.VarChar(120)
  body    String           @db.VarChar(500)
  isRead  Boolean          @default(false)
  orderId String?          @db.Uuid

  /// Destination au TAP : `produit:nouveau-riz`, `commande:AGR-2026-0042`…
  /// Sans elle, l'application ouvre la liste des notifications — mieux qu'un
  /// écran vide, mais moins bien que la bonne fiche.
  linkTarget String? @db.VarChar(30)
  linkValue  String? @db.VarChar(120)

  /// Campagne à l'origine de la notification, pour les statistiques.
  campaignId String? @db.Uuid
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([campaignId])
}

/* ───────────────────────────── Producteur ──────────────────────────── */

model Producer {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String @db.VarChar(120)
  region      String? @db.VarChar(80)
  farms       Farm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id         String  @id @default(uuid()) @db.Uuid
  producerId String  @db.Uuid
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  name       String  @db.VarChar(120)
  location   String? @db.VarChar(160)
  areaHectares Float?
  latitude   Float?
  longitude  Float?
  /// Une parcelle mise en jachère est conservée pour son historique, mais ne
  /// doit plus apparaître dans les saisies courantes.
  isActive   Boolean @default(true)

  productions Production[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([producerId])
}

model Production {
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @db.Uuid
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  season      String   @db.VarChar(40)
  cropVariety String   @db.VarChar(80)
  /// Quantité en kilogrammes.
  quantityKg  Int
  /// Objectif de la saison, en kilogrammes. Sert au taux d'avancement affiché
  /// au producteur ; facultatif car toutes les saisons n'en fixent pas.
  targetKg    Int?
  harvestedAt DateTime?
  status      ProductionStatus @default(DECLARED)
  /// Renseigné uniquement lors d'un rejet, pour que le producteur sache quoi
  /// corriger plutôt que de subir un refus opaque.
  reviewNote  String? @db.VarChar(300)
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([farmId])
  @@index([status])
}

/* ─────────────────────────── Fichiers / Config ─────────────────────── */

model FileAsset {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  url        String
  mimeType   String   @db.VarChar(100)
  sizeBytes  Int
  uploadedBy String?  @db.Uuid
  createdAt  DateTime @default(now())
}

/// Paramètres société modifiables sans redéploiement (section 20).
model CompanySetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(60)
  value String
  updatedAt DateTime @updatedAt
}

/// Compteur de références de commande, par année. Évite les collisions.
model OrderCounter {
  year    Int @id
  current Int @default(0)
}

/* ─────────── Fondations SSOT (refonte — voir docs/refonte/) ───────────
   Convention de nommage : les tables TECHNIQUES introduites par la refonte
   et pilotées en SQL brut adoptent le snake_case (@@map) ; les tables
   métier conservent la convention Prisma existante. Une seule règle : ne
   JAMAIS renommer une table métier existante (14 migrations en dépendent). */

/// Prix promotionnel daté, posé par le back-office.
///
/// Le prix barré cesse d'être une colonne figée sur la variante : c'est un
/// état daté, avec un début et une fin, dont l'API calcule le prix effectif
/// (`promo active sinon prix de base`). Un seul prix actif par variante,
/// garanti par un index partiel unique en base (migration fondations).
model Promotion {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Prix promotionnel en XOF entier. Ne peut pas être négatif ni absurde :
  /// vérifié par le service de back-office, pas par la base.
  priceXof Int
  /// Libellé affiché aux clients (« Rentrée », « Fin de série »…).
  label String @db.VarChar(80)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, isActive])
}

/// Code promotionnel, géré par AGRIM depuis l'administration.
///
/// Pourquoi une table LOCALE alors que le site calcule aussi des remises :
/// le site est la source du catalogue et des remises de volume, mais un code
/// créé ici doit pouvoir être vérifié même si le site est injoignable — sinon
/// AGRIM annonce une promotion que l'application refuse d'appliquer. Le
/// serveur reste seul juge : le client envoie une chaîne, jamais un montant.
model PromoCode {
  id String @id @default(uuid()) @db.Uuid

  /// Code saisi par le client, en majuscules.
  code        String  @unique @db.VarChar(40)
  description String? @db.VarChar(200)

  discountType  PromoDiscountType
  /// Pourcentage (1–100) ou montant XOF entier, selon le type.
  discountValue Int

  /// Montant minimum de panier, en XOF. `null` = pas de minimum.
  minOrderTotal Int?
  /// Quota global. `null` = illimité.
  maxUses       Int?
  usedCount     Int  @default(0)
  /// Quota par numéro de téléphone. `null` = illimité.
  maxUsesPerPhone Int?
  /// Zone de livraison concernée. `null` = toutes.
  zone          String? @db.VarChar(40)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  isActive Boolean   @default(true)

  /// Références produits concernées (`sourceRef` ou `sku`). Vide = tout.
  /// Tableau PostgreSQL plutôt qu'une table de liaison : la règle tient en
  /// quelques dizaines de références, et une jointure de plus ne servirait
  /// personne.
  appliesTo String[] @default([])

  createdById String? @db.Uuid
  createdBy   User?   @relation("PromoCodesCreated", fields: [createdById], references: [id])

  redemptions PromoCodeRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("promo_codes")
}

/// Trace d'utilisation d'un code : une ligne par commande remisée.
///
/// Elle sert deux choses distinctes : compter les usages par téléphone (quota
/// individuel) et pouvoir expliquer, des mois plus tard, pourquoi une commande
/// a été facturée moins cher.
model PromoCodeRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promoCodeId String    @db.Uuid
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  /// Référence de commande — sans clé étrangère : la trace doit survivre à la
  /// purge des commandes (même règle que `MessageLog`).
  orderReference String @db.VarChar(20)
  phone          String @db.VarChar(20)
  /// Remise réellement appliquée, en XOF entier.
  discount       Int
  /** Panier au moment de l'application, pour l'audit. */
  orderTotal     Int

  createdAt DateTime @default(now())

  @@unique([promoCodeId, orderReference])
  @@index([promoCodeId, phone])
  @@map("promo_code_redemptions")
}

/// Point de vente AGRIM (usine, boutique, dépôt).
///
/// Adresses commerciales : elles changent, et un changement ne doit pas exiger
/// une nouvelle version de l'application. Aucune n'est pré-remplie : une
/// adresse inventée enverrait un client au mauvais endroit.
model PointOfSale {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  address     String  @db.VarChar(255)
  city        String  @db.VarChar(80)
  landmark    String? @db.VarChar(200)
  phone       String? @db.VarChar(30)
  openingHours String? @db.VarChar(120)
  latitude    Float?
  longitude   Float?

  /// Le point accepte-t-il le retrait d'une commande passée dans l'app ?
  supportsPickup Boolean @default(true)
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("points_of_sale")
}

/// Verrou d'exclusion mutuelle des tâches planifiées (cron cPanel).
///
/// Les crons cPanel réveillent l'API par HTTP ; rien n'empêche deux
/// déclencheurs de se chevaucher (double ligne crontab, cadence trop serrée
/// devant un job lent). Le verrou est pris par un INSERT ... ON CONFLICT
/// atomique — voir `CronLocksService`. Le bail (`lockedUntil`) est vital sur
/// Passenger : si le processus est recyclé au milieu d'un job, le verrou doit
/// se libérer tout seul, sinon plus aucune exécution ne passerait jamais.
model CronLock {
  job String @id @db.VarChar(60)

  /// Non nuls tant qu'un job tient le verrou.
  lockedAt    DateTime?
  lockedUntil DateTime?

  lastRunStartedAt   DateTime?
  lastRunFinishedAt  DateTime?
  lastStatus         String?   @db.VarChar(20)
  lastError          String?   @db.VarChar(500)
  runCount           Int       @default(0)
  updatedAt          DateTime  @updatedAt

  @@map("cron_locks")
}

/// Outbox transactionnelle — le pont entre le métier et la diffusion.
///
/// Écrite DANS la transaction métier (une commande confirmée et son événement
/// existent ensemble ou pas du tout), elle est consommée après coup par le
/// dispatcher de notifications. Sur Passenger, le processus peut être recyclé
/// entre l'écriture et la consommation : l'événement est en base, il ne se
/// perd pas, il arrive en retard — le cron `outbox-drain` rattrape.
///
/// Nom délibérément `outbox_events` (et non `notifications_queue`) : la table
/// porte des événements MÉTIER, dont les notifications ne sont qu'un
/// consommateur. Le jour où l'analytics ou la facturation y souscrit, le nom
/// restera vrai.
model OutboxEvent {
  id      String @id @default(uuid()) @db.Uuid
  /// Type d'événement (`ORDER_CONFIRMED`, `PAYMENT_SUCCEEDED`, …).
  type    String @db.VarChar(60)
  payload Json

  status      String   @default("PENDING") @db.VarChar(20) // PENDING|PROCESSING|DONE|FAILED
  attempts    Int      @default(0)
  /// Disponible à partir de — sert le back-off des reprises.
  availableAt DateTime @default(now())
  processedAt DateTime?
  lastError   String?  @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@index([type, createdAt])
  @@map("outbox_events")
}

/// Webhook entrant des agrégateurs de paiement — dédoublonné.
///
/// L'index unique (provider, externalId) est L'idempotence du webhook : un
/// appel rejoué par CinetPay est reconnu, journalisé, sans effet. Le payload
/// brut est conservé douze mois : un litige se règle sur les octets reçus,
/// pas sur notre reconstruction.
model WebhookEvent {
  id         String  @id @default(uuid()) @db.Uuid
  /// `cinetpay`, `paydunya`…
  provider   String  @db.VarChar(20)
  /// Identifiant de transaction chez le fournisseur (`cpm_trans_id`).
  externalId String  @db.VarChar(120)
  signatureValid Boolean
  /// RECEIVED|PROCESSED|IGNORED|REJECTED
  status     String  @default("RECEIVED") @db.VarChar(20)
  payload    Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([provider, receivedAt])
}

/// Idempotence générique des opérations sensibles (paiements, jobs).
///
/// Une clé = une empreinte de requête = une réponse figée. Les commandes,
/// elles, portent leur clé directement (`Order.idempotencyKey`) ; cette table
/// sert aux opérations qui n'ont pas de table naturellement unique.
model IdempotencyRecord {
  scope       String @db.VarChar(60)
  key         String @db.VarChar(120)

  requestHash    String  @db.VarChar(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@id([scope, key])
  @@index([expiresAt])
}

/// Journal unifié des envois sortants : push FCM, WhatsApp, SMS, e-mail.
///
/// Un seul endroit répond à « ce client a-t-il été prévenu ? » — quel que soit
/// le canal. Une panne d'agrégateur y laisse une ligne FAILED consultable et
/// rejouable, jamais un silence.
model SieveSession {
  id          String   @id @default(uuid()) @db.Uuid
  instruction String   @db.VarChar(2000)
  status      String   @default("queued") @db.VarChar(20)
  error       String?  @db.VarChar(1000)
  turns       String?  @db.Text
  updatedAt   DateTime @updatedAt

  /// The run may have consumed credits before the driver wrote this row: a
  /// crash here means the driver must resume polling this session, not start.
  @@index([status, updatedAt])
}

model MessageLog {
  id       String @id @default(uuid()) @db.Uuid
  /// PUSH|WHATSAPP|SMS|EMAIL
  channel  String @db.VarChar(20)
  template String? @db.VarChar(60)
  toAddress String @db.VarChar(200)

  /// Références informatives, SANS clé étrangère : un journal doit survivre
  /// à la purge de ce qu'il décrit.
  userId        String? @db.Uuid
  orderId       String? @db.Uuid
  outboxEventId String? @db.Uuid

  providerMessageId String? @db.VarChar(160)
  /// QUEUED|SENT|FAILED
  status            String  @default("QUEUED") @db.VarChar(20)
  error             String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([outboxEventId])
  @@index([userId, createdAt])
}
