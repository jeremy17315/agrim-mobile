// AGRIM-Mobile — schéma PostgreSQL
// Toute modification passe par une migration Prisma (section 12).
// Montants : entiers XOF, sans décimales. Poids : grammes entiers.

// Générateur « prisma-client » (Prisma 7, Rust-free) : aucun moteur natif,
// le client parle PostgreSQL via l'adaptateur @prisma/adapter-pg déjà en
// place (src/prisma/prisma.client.ts). Le générateur hérité
// « prisma-client-js », lui, exige le téléchargement de moteurs natifs —
// impossible sur un réseau filtré, et inutile ici.
generator client {
  provider                = "prisma-client"
  output                  = "../generated/prisma"
  runtime                 = "nodejs"
  moduleFormat            = "cjs"
  generatedFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}

/* ─────────────────────────────── Enums ─────────────────────────────── */

enum Role {
  CLIENT
  LIVREUR
  PRODUCTEUR
  GESTIONNAIRE
  ADMIN
  DG
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  CASH_ON_DELIVERY
}

enum MobileMoneyProvider {
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  WAVE
}

/// Méthodes de preuve retenues. Le code de confirmation a été écarté :
/// il échoue précisément quand on en a besoin (téléphone déchargé, tiers
/// qui réceptionne).
/// Origine de la clôture d'une livraison.
enum DeliveryClosureMode {
  /// Code dicté par le client et vérifié par le backend. Cas nominal.
  CLIENT_OTP

  /// Clôture par un gestionnaire, pour une remise réelle qu'aucun code ne
  /// pouvait valider. Motif obligatoire, auteur enregistré.
  MANAGER_OVERRIDE
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  IN_TRANSIT
  ARRIVED
  OTP_VERIFIED
  DELIVERED
  FAILED
}

/// Cycle de vie d'une déclaration de production.
/// Le producteur déclare ; la coopérative vérifie puis réceptionne. Un
/// producteur ne fait donc jamais passer sa propre déclaration en RECEIVED.
enum ProductionStatus {
  DECLARED
  CONFIRMED
  RECEIVED
  REJECTED
}

/// Origine d'un mouvement de stock.
///
/// Le signe de `quantity` dit le sens (+ entrée, − sortie) ; ce type dit la
/// RAISON. Les deux sont nécessaires : un −2 de commande et un −2 de casse
/// n'appellent pas la même lecture d'inventaire.
enum StockMovementType {
  /// Réapprovisionnement : de la marchandise entre en entrepôt.
  ENTREE

  /// Retrait décidé par la gestion : casse, don, prélèvement.
  SORTIE

  /// Correction d'inventaire après comptage physique. Ni entrée ni sortie
  /// réelle : c'est le compteur qui avait tort.
  AJUSTEMENT

  /// Réservé par une commande client.
  COMMANDE

  /// Rendu par l'annulation d'une commande.
  ANNULATION

  /// Marchandise revenue en entrepôt après coup.
  RETOUR
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  DELIVERY_ASSIGNED
  DELIVERY_OTP
  DELIVERY_FAILED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  LOW_STOCK
}

/* ──────────────────────────── Utilisateurs ─────────────────────────── */

model User {
  id           String  @id @default(uuid()) @db.Uuid
  firstName    String  @db.VarChar(80)
  lastName     String  @db.VarChar(80)
  // Le téléphone est l'identifiant naturel en Côte d'Ivoire.
  phone        String  @unique @db.VarChar(20)
  email        String? @unique @db.VarChar(160)
  passwordHash String
  role         Role    @default(CLIENT)
  isActive     Boolean @default(true)

  // Parrainage (section 33). `referralCode` est attribué à l'inscription de
  // TOUS les comptes (pas seulement CLIENT), pour rester simple. Le crédit
  // est un solde générique, alimenté aujourd'hui uniquement par le
  // parrainage. `referralRewardedAt` vit sur le FILLEUL : il garantit qu'un
  // même filleul ne déclenche jamais deux fois la récompense de son parrain.
  referralCode       String    @unique @db.VarChar(12)
  referredById       String?   @db.Uuid
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")
  referralRewardedAt DateTime?
  creditBalanceXof   Int       @default(0)

  addresses      Address[]
  cart           Cart?
  orders         Order[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  deliveries     Delivery[]     @relation("CourierDeliveries")
  closedDeliveries Delivery[]   @relation("ClosedDeliveries")
  producer       Producer?
  pushTokens     PushToken[]
  productReviews ProductReview[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([referredById])
}

/// Refresh tokens hachés + rotation. Jamais stockés en clair.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Adresse adaptée au contexte ivoirien : GPS + repères, pas une simple rue.
model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String  @db.VarChar(60)
  city         String  @db.VarChar(80)
  commune      String? @db.VarChar(80)
  district     String? @db.VarChar(120)
  landmark     String? @db.VarChar(255)
  instructions String? @db.VarChar(500)
  contactPhone String  @db.VarChar(20)
  latitude     Float?
  longitude    Float?
  isDefault    Boolean @default(false)

  orders     Order[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/* ───────────────────────────── Catalogue ───────────────────────────── */

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(60)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]

  /// Code de la gamme côté SITE (EBE, DIE, DJA, DV, ROY, SIK).
  /// C'est la clé de synchronisation : renommer une gamme dans le back
  /// office du site ne doit pas créer une catégorie en double ici.
  sourceCode String? @unique @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String  @id @default(uuid()) @db.Uuid
  slug             String  @unique @db.VarChar(80)
  name             String  @db.VarChar(120)
  shortDescription String? @db.VarChar(200)
  description      String? @db.VarChar(2000)
  brand            String  @default("RIZ BOAGNI") @db.VarChar(80)
  imageUrl         String?
  isFeatured       Boolean @default(false)
  isActive         Boolean @default(true)

  categoryId String           @db.Uuid
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  reviews    ProductReview[]

  /// Code de la gamme côté SITE — même rôle que Category.sourceCode.
  sourceCode String? @unique @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

/// Variante = format commercial. Prix en XOF entier, poids en grammes.
model ProductVariant {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String  @unique @db.VarChar(60)
  label       String  @db.VarChar(40)
  weightGrams Int
  price       Int
  /// Prix barré affiché en promotion (grille agrimsarl.ci). `null` = pas de
  /// promotion en cours.
  originalPrice Int?
  stock       Int     @default(0)
  /// Seuil d'alerte de réapprovisionnement, propre à chaque variante : un
  /// format 22,5 kg ne se réapprovisionne pas au même rythme qu'un 900 g.
  lowStockThreshold Int @default(20)
  isAvailable Boolean @default(true)

  /// Référence de la variante côté SITE (RB-EBE-05, RB-DC-225…).
  /// Clé de synchronisation du catalogue : c'est elle qui identifie une
  /// variante d'une exécution à l'autre, jamais le sku ni le libellé, qui
  /// peuvent être corrigés dans le back office du site.
  sourceRef String? @unique @db.VarChar(40)
  /// Dernière synchronisation réussie de cette variante depuis le site.
  syncedAt  DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  StockMovement[]
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/// Journal des mouvements de stock — une ligne par variation, sans exception.
///
/// Pourquoi cette table existe
/// ───────────────────────────
/// Le stock était un simple compteur : on lisait 148 sans pouvoir dire si
/// c'était 150 moins deux ventes, ou 200 moins une erreur de saisie. Un écart
/// d'inventaire n'était donc ni explicable ni imputable, et une correction
/// silencieuse ne laissait aucune trace.
///
/// Ce journal est le SEUL endroit qui répond à « pourquoi ce chiffre ? ».
/// Il est écrit dans la même transaction que la variation qu'il décrit : un
/// mouvement sans écriture de stock, ou l'inverse, n'existe pas.
///
/// `stockBefore` et `stockAfter` sont conservés bien qu'ils soient
/// recalculables : les relire évite de rejouer tout l'historique pour
/// comprendre une ligne, et surtout ils figent ce que le système CROYAIT au
/// moment du geste. Un écart entre `stockAfter` d'une ligne et `stockBefore`
/// de la suivante est le signal qu'une écriture a échappé au journal.
model StockMovement {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type StockMovementType

  /// Variation SIGNÉE : +50 à la réception, −2 à la commande.
  /// Jamais zéro — un mouvement nul n'est pas un mouvement.
  quantity    Int
  stockBefore Int
  stockAfter  Int

  /// Motif libre. Obligatoire pour un ajustement d'inventaire (règle tenue
  /// par le service, pas par la base : le motif d'une commande est implicite).
  reason String? @db.VarChar(300)

  /// Référence de commande pour les mouvements qui en découlent. C'est la
  /// clé qui permet de remonter d'un écart de stock à la vente qui l'explique.
  reference String? @db.VarChar(40)

  /// Auteur du geste. `null` pour un mouvement produit par le système
  /// (réservation à la commande, restitution par expiration d'un paiement) :
  /// mentir sur l'auteur serait pire que l'absence d'auteur.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  /// Sert la requête la plus fréquente : l'historique d'une variante, du plus
  /// récent au plus ancien.
  @@index([variantId, createdAt(sort: Desc)])
  @@index([type, createdAt])
  @@index([reference])
}

/// Avis client sur un produit.
///
/// Un couple (client, produit) : on note le riz, pas la commande. Modifier
/// son avis écrase le précédent plutôt que d'en empiler plusieurs.
model ProductReview {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Entier 1–5. Jamais de demi-étoile : un tap = une étoile.
  rating  Int
  comment String @db.VarChar(800)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

/* ─────────────────────────────── Panier ────────────────────────────── */

model Cart {
  id     String     @id @default(uuid()) @db.Uuid
  userId String     @unique @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un seul item par variante et par panier.
  @@unique([cartId, variantId])
  @@index([cartId])
}

/* ────────────────────────────── Commandes ──────────────────────────── */

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  reference String      @unique @db.VarChar(20)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)

  // Prix figés au moment de la commande (ne suivent pas le catalogue).
  subtotal    Int
  deliveryFee Int
  total       Int

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id])
  note      String? @db.VarChar(500)

  /// Empêche les doublons quand le réseau coupe et que le mobile rejoue.
  idempotencyKey String @unique @db.Uuid

  items    OrderItem[]
  payment  Payment?
  delivery Delivery?
  events   OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Dénormalisé volontairement : l'historique doit rester lisible même si
  // le produit est renommé ou supprimé du catalogue.
  productName  String @db.VarChar(120)
  variantLabel String @db.VarChar(40)
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  @@index([orderId])
}

/// Journal d'audit des transitions de statut.
model OrderEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actorId   String?     @db.Uuid
  comment   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/* ────────────────────────────── Paiement ───────────────────────────── */

/// Le statut fait foi côté serveur uniquement (webhook), jamais côté mobile.
model Payment {
  id       String               @id @default(uuid()) @db.Uuid
  orderId  String               @unique @db.Uuid
  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method   PaymentMethod
  provider MobileMoneyProvider?
  status   PaymentStatus        @default(PENDING)
  amount   Int

  providerReference String?   @db.VarChar(120)
  failureReason     String?   @db.VarChar(255)
  expiresAt         DateTime?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/* ────────────────────────────── Livraison ──────────────────────────── */

model Delivery {
  id      String         @id @default(uuid()) @db.Uuid
  orderId String         @unique @db.Uuid
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  DeliveryStatus @default(UNASSIGNED)

  courierId String? @db.Uuid
  courier   User?   @relation("CourierDeliveries", fields: [courierId], references: [id])

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id])

  failureReason String? @db.VarChar(255)

  /// Traçabilité de la validation par OTP : où et quand la course a été
  /// close. La position est facultative — le GPS documente la remise, il ne
  /// la conditionne pas.
  otpVerifiedAt DateTime?
  otpLatitude   Float?
  otpLongitude  Float?

  /// Comment la course a été close.
  ///
  /// Mesurable délibérément : une clôture d'exception reste légitime, mais si
  /// elle devient fréquente, c'est le signe que le parcours par code ne
  /// fonctionne pas sur le terrain. Sans cette colonne, personne ne le verrait.
  closureMode   DeliveryClosureMode?
  closedById    String?              @db.Uuid
  closedBy      User?                @relation("ClosedDeliveries", fields: [closedById], references: [id])
  closureReason String?              @db.VarChar(500)

  assignedAt  DateTime?
  acceptedAt  DateTime?
  inTransitAt DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  otps      DeliveryOtp[]
  locations DeliveryLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId, status])
  @@index([status])
  @@index([closureMode])
}

/// Code de validation de livraison.
///
/// Le code n'est JAMAIS stocké en clair : seule son empreinte l'est, comme un
/// mot de passe. Une fuite de la base ne permet donc pas de valider une
/// livraison. Le livreur ne le reçoit par aucun canal — il le saisit sous la
/// dictée du client.
///
/// L'historique est conservé (une ligne par génération) plutôt qu'écrasé : en
/// cas de litige, il faut pouvoir montrer combien de codes ont été émis et
/// lequel a validé la remise.
model DeliveryOtp {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  /// SHA-256 du code, pour la vérification (comparaison d'empreintes).
  codeHash String @db.VarChar(64)

  /// Le code CHIFFRÉ (AES-256-GCM), pour que son propriétaire puisse le relire.
  ///
  /// Le hachage seul ne suffisait pas : le client doit pouvoir consulter son
  /// code afin de le dicter. Tant qu'il vivait en clair dans le corps de la
  /// notification, hacher cette colonne ne protégeait rien.
  codeCipher String

  expiresAt DateTime

  /// Tentatives de saisie infructueuses, plafonnées.
  attempts Int @default(0)

  /// Renseigné une seule fois : un code vérifié est définitivement consommé.
  verifiedAt DateTime?

  /// Invalidation d'un code encore actif lors d'une régénération : à tout
  /// moment, une livraison n'a qu'un seul code utilisable.
  invalidatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
}

/// Trace GPS d'une course.
///
/// Minimisation des donnees : aucune position n'est collectee hors livraison
/// active, et les traces sont purgees apres livraison (TRACKING_CONFIG).
/// `recordedAt` est l'horodatage de la MESURE, pas de la reception serveur :
/// les points emis hors ligne sont rejoues plus tard sans fausser le trajet.
model DeliveryLocation {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  /// Precision horizontale en metres.
  accuracy  Float?
  /// Cap en degres, 0 = nord.
  heading   Float?
  /// Vitesse instantanee en m/s.
  speed     Float?

  recordedAt DateTime
  createdAt  DateTime @default(now())

  /// Deduplication des rejeux hors ligne : un meme point ne peut entrer deux fois.
  @@unique([deliveryId, recordedAt])
  /// Sert la lecture « derniere position connue », requete la plus frequente.
  @@index([deliveryId, recordedAt(sort: Desc)])
}

/* ──────────────────────────── Notifications ────────────────────────── */

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String           @db.VarChar(120)
  body    String           @db.VarChar(500)
  isRead  Boolean          @default(false)
  orderId String?          @db.Uuid

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/* ───────────────────────────── Producteur ──────────────────────────── */

model Producer {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String @db.VarChar(120)
  region      String? @db.VarChar(80)
  farms       Farm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id         String  @id @default(uuid()) @db.Uuid
  producerId String  @db.Uuid
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  name       String  @db.VarChar(120)
  location   String? @db.VarChar(160)
  areaHectares Float?
  latitude   Float?
  longitude  Float?
  /// Une parcelle mise en jachère est conservée pour son historique, mais ne
  /// doit plus apparaître dans les saisies courantes.
  isActive   Boolean @default(true)

  productions Production[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([producerId])
}

model Production {
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @db.Uuid
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  season      String   @db.VarChar(40)
  cropVariety String   @db.VarChar(80)
  /// Quantité en kilogrammes.
  quantityKg  Int
  /// Objectif de la saison, en kilogrammes. Sert au taux d'avancement affiché
  /// au producteur ; facultatif car toutes les saisons n'en fixent pas.
  targetKg    Int?
  harvestedAt DateTime?
  status      ProductionStatus @default(DECLARED)
  /// Renseigné uniquement lors d'un rejet, pour que le producteur sache quoi
  /// corriger plutôt que de subir un refus opaque.
  reviewNote  String? @db.VarChar(300)
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([farmId])
  @@index([status])
}

/* ─────────────────────────── Fichiers / Config ─────────────────────── */

model FileAsset {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  url        String
  mimeType   String   @db.VarChar(100)
  sizeBytes  Int
  uploadedBy String?  @db.Uuid
  createdAt  DateTime @default(now())
}

/// Paramètres société modifiables sans redéploiement (section 20).
model CompanySetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(60)
  value String
  updatedAt DateTime @updatedAt
}

/// Compteur de références de commande, par année. Évite les collisions.
model OrderCounter {
  year    Int @id
  current Int @default(0)
}

/* ─────────── Fondations SSOT (refonte — voir docs/refonte/) ───────────
   Convention de nommage : les tables TECHNIQUES introduites par la refonte
   et pilotées en SQL brut adoptent le snake_case (@@map) ; les tables
   métier conservent la convention Prisma existante. Une seule règle : ne
   JAMAIS renommer une table métier existante (14 migrations en dépendent). */

/// Prix promotionnel daté, posé par le back-office.
///
/// Le prix barré cesse d'être une colonne figée sur la variante : c'est un
/// état daté, avec un début et une fin, dont l'API calcule le prix effectif
/// (`promo active sinon prix de base`). Un seul prix actif par variante,
/// garanti par un index partiel unique en base (migration fondations).
model Promotion {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Prix promotionnel en XOF entier. Ne peut pas être négatif ni absurde :
  /// vérifié par le service de back-office, pas par la base.
  priceXof Int
  /// Libellé affiché aux clients (« Rentrée », « Fin de série »…).
  label String @db.VarChar(80)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, isActive])
}

/// Verrou d'exclusion mutuelle des tâches planifiées (cron cPanel).
///
/// Les crons cPanel réveillent l'API par HTTP ; rien n'empêche deux
/// déclencheurs de se chevaucher (double ligne crontab, cadence trop serrée
/// devant un job lent). Le verrou est pris par un INSERT ... ON CONFLICT
/// atomique — voir `CronLocksService`. Le bail (`lockedUntil`) est vital sur
/// Passenger : si le processus est recyclé au milieu d'un job, le verrou doit
/// se libérer tout seul, sinon plus aucune exécution ne passerait jamais.
model CronLock {
  job String @id @db.VarChar(60)

  /// Non nuls tant qu'un job tient le verrou.
  lockedAt    DateTime?
  lockedUntil DateTime?

  lastRunStartedAt   DateTime?
  lastRunFinishedAt  DateTime?
  lastStatus         String?   @db.VarChar(20)
  lastError          String?   @db.VarChar(500)
  runCount           Int       @default(0)
  updatedAt          DateTime  @updatedAt

  @@map("cron_locks")
}

/// Outbox transactionnelle — le pont entre le métier et la diffusion.
///
/// Écrite DANS la transaction métier (une commande confirmée et son événement
/// existent ensemble ou pas du tout), elle est consommée après coup par le
/// dispatcher de notifications. Sur Passenger, le processus peut être recyclé
/// entre l'écriture et la consommation : l'événement est en base, il ne se
/// perd pas, il arrive en retard — le cron `outbox-drain` rattrape.
///
/// Nom délibérément `outbox_events` (et non `notifications_queue`) : la table
/// porte des événements MÉTIER, dont les notifications ne sont qu'un
/// consommateur. Le jour où l'analytics ou la facturation y souscrit, le nom
/// restera vrai.
model OutboxEvent {
  id      String @id @default(uuid()) @db.Uuid
  /// Type d'événement (`ORDER_CONFIRMED`, `PAYMENT_SUCCEEDED`, …).
  type    String @db.VarChar(60)
  payload Json

  status      String   @default("PENDING") @db.VarChar(20) // PENDING|PROCESSING|DONE|FAILED
  attempts    Int      @default(0)
  /// Disponible à partir de — sert le back-off des reprises.
  availableAt DateTime @default(now())
  processedAt DateTime?
  lastError   String?  @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@index([type, createdAt])
  @@map("outbox_events")
}

/// Webhook entrant des agrégateurs de paiement — dédoublonné.
///
/// L'index unique (provider, externalId) est L'idempotence du webhook : un
/// appel rejoué par CinetPay est reconnu, journalisé, sans effet. Le payload
/// brut est conservé douze mois : un litige se règle sur les octets reçus,
/// pas sur notre reconstruction.
model WebhookEvent {
  id         String  @id @default(uuid()) @db.Uuid
  /// `cinetpay`, `paydunya`…
  provider   String  @db.VarChar(20)
  /// Identifiant de transaction chez le fournisseur (`cpm_trans_id`).
  externalId String  @db.VarChar(120)
  signatureValid Boolean
  /// RECEIVED|PROCESSED|IGNORED|REJECTED
  status     String  @default("RECEIVED") @db.VarChar(20)
  payload    Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([provider, receivedAt])
}

/// Idempotence générique des opérations sensibles (paiements, jobs).
///
/// Une clé = une empreinte de requête = une réponse figée. Les commandes,
/// elles, portent leur clé directement (`Order.idempotencyKey`) ; cette table
/// sert aux opérations qui n'ont pas de table naturellement unique.
model IdempotencyRecord {
  scope       String @db.VarChar(60)
  key         String @db.VarChar(120)

  requestHash    String  @db.VarChar(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@id([scope, key])
  @@index([expiresAt])
}

/// Journal unifié des envois sortants : push FCM, WhatsApp, SMS, e-mail.
///
/// Un seul endroit répond à « ce client a-t-il été prévenu ? » — quel que soit
/// le canal. Une panne d'agrégateur y laisse une ligne FAILED consultable et
/// rejouable, jamais un silence.
model MessageLog {
  id       String @id @default(uuid()) @db.Uuid
  /// PUSH|WHATSAPP|SMS|EMAIL
  channel  String @db.VarChar(20)
  template String? @db.VarChar(60)
  toAddress String @db.VarChar(200)

  /// Références informatives, SANS clé étrangère : un journal doit survivre
  /// à la purge de ce qu'il décrit.
  userId        String? @db.Uuid
  orderId       String? @db.Uuid
  outboxEventId String? @db.Uuid

  providerMessageId String? @db.VarChar(160)
  /// QUEUED|SENT|FAILED
  status            String  @default("QUEUED") @db.VarChar(20)
  error             String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([outboxEventId])
  @@index([userId, createdAt])
}
