{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // rootDir à la racine de l'app : le client Prisma généré (generated/,
    // sources TypeScript depuis le générateur « prisma-client » v7) est
    // compilé AVEC src/ — dist/ reflète les deux arbres (dist/src, dist/generated).

    "rootDir": "./",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  // Tests COMPRIS : c'est la configuration que retient l'éditeur, et un
  // fichier qui n'appartient à aucun projet TypeScript y apparaît en erreur.
  // L'exclusion qui compte — ne pas émettre les tests dans `dist` — vit
  // désormais dans `tsconfig.build.json`.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "generated"]
}
