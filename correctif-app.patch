+ * ivoiriens à 10 chiffres reçoivent l'indicatif 225.
+ */
+export function telephoneInternational(numero: string): string {
+  const chiffres = (numero ?? '').replace(/[^\d+]/g, '').replace(/^\+/, '');
+  if (!chiffres) {
+    throw new PaymentGatewayError('Numéro de téléphone invalide.');
+  }
+  if (chiffres.startsWith('225')) return `+${chiffres}`;
+  if (chiffres.length === 10) return `+225${chiffres}`;
+  return `+${chiffres}`;
