+export function decouperNom(nomComplet: string): [string, string] {
+  const mots = (nomComplet ?? '').trim().split(/\s+/).filter(Boolean);
+  const prenom = ajusterLongueur(mots[0] ?? 'Client');
+  const nom = ajusterLongueur(mots.slice(1).join(' ') || prenom);
