{
  "name": "agrim-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "AGRIM-Mobile — plateforme mobile AGRIM / RIZ BOAGNI",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "api:dev": "npm run start:dev -w @agrim/api",
    "apk:adresse": "node scripts/adresse-api.mjs",
    "mobile:web": "npm run web -w @agrim/mobile",
    "reparer:metro": "node scripts/reparer-metro.mjs",
    "db:migrate": "npm run db:migrate -w @agrim/api",
    "db:seed": "npm run db:seed -w @agrim/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
